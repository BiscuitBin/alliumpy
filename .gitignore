.DS_Store
.cache/
.env
.env.*
!.env.example

# lychee's link cache: `cache = true` in lychee.toml, so the offline hook
# writes it beside the config and reads it on the next run.
.lycheecache

# Scratch for agents and maintainers alike: anything that is not a
# deliverable goes here, never in a commit.
ai_tmp/

# Claude Code writes runtime state into .claude/ mid-session
# (settings.local.json, scheduled-task locks, checkpoints, nested worktrees).
# bg-validate-agents lists files with `git ls-files --cached --others
# --exclude-from=.gitignore` and reports any other file under .claude/ as an
# unexpected managed file, so everything there is ignored except the tracked
# skills. Codex writes its local settings on first use.
.claude/*
!.claude/skills/
.codex/settings.local.json

# Build products: the wheel smoke's virtual environment and anything else a
# recipe writes. `just check` snapshots the worktree between recipes, so a
# build product Git can see would abort the run before any recipe's exit
# code is read.
target/

# The pixi environment `just initialize` installs from pixi.lock: every tool
# binary, Python, prek and the tooling package's scripts. Ignored for the same
# reason as target/: `just check` snapshots the worktree between recipes, and
# an environment Git can see aborts the snapshot.
.pixi/

# Wheel output.
dist/

# Crawl output never lives in the tree: it goes under ai_tmp/, except the
# reports and samples committed under examples/.
*.egg-info/

# Python bytecode, tool caches and local virtual environments.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
