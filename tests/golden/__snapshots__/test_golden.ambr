  </tr>
  <tr>
  <td>
  <h3 id="modify"><code><a href="https://developers.google.com/workspace/gmail/api/reference/rest/v1/users.messages/modify">modify</a></code></h3></td>
  <td> Modifies the labels and the Classification Label values on the specified message.</td>
  </tr>
  <tr>
  <td>
  <h3 id="send"><code><a href="https://developers.google.com/workspace/gmail/api/reference/rest/v1/users.messages/send">send</a></code></h3></td>
