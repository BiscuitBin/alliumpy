  <th>Description</th>
  </tr>
  </thead>
  <tbody>
  <tr>
  <td>acceptedSenders</td>
  <td><a href="https://learn.microsoft.com/en-us/graph/api/resources/directoryobject?view=graph-rest-1.0">directoryObject</a> collection</td>
  <td>The list of users or groups allowed to create posts or calendar events in this group. If this list is nonempty, then only users or groups listed here are allowed to post.</td>
  </tr>
  <tr>
  <td>appRoleAssignments</td>
  <td><a href="https://learn.microsoft.com/en-us/graph/api/resources/approleassignment?view=graph-rest-1.0">appRoleAssignment</a> collection</td>
