  <code><a href="https://developers.google.com/workspace/gmail/api/reference/rest/v1/users.threads/modify">modify</a></code></td>
  <td>
  <code>POST /gmail/v1/users/{userId}/threads/{id}/modify</code> <br> Modifies the labels applied to the thread.</td>
  </tr>
  <tr>
  <td>
  <code><a href="https://developers.google.com/workspace/gmail/api/reference/rest/v1/users.threads/trash">trash</a></code></td>
  <td>
  <code>POST /gmail/v1/users/{userId}/threads/{id}/trash</code> <br> Moves the specified thread to the trash.</td>
  </tr>
  <tr>
  <td>
  <code><a href="https://developers.google.com/workspace/gmail/api/reference/rest/v1/users.threads/untrash">untrash</a></code></td>
  <td>
  <code>POST /gmail/v1/users/{userId}/threads/{id}/untrash</code> <br> Removes the specified thread from the trash.</td>
  </tr>
  </tbody>
  </table>
  
  '''
# ---
