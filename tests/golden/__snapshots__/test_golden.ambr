    "displayName": "String",
    "drive": { "@odata.type": "microsoft.graph.drive" },
    "events": [{ "@odata.type": "microsoft.graph.event" }],
    "groupTypes": ["String"],
    "hasMembersWithLicenseErrors": "Boolean",
    "hideFromAddressLists": "Boolean",
    "hideFromOutlookClients": "Boolean",
