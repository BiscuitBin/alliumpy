  </tr>
  <tr>
  <td>
  <code><a href="https://developers.google.com/workspace/gmail/api/reference/rest/v1/users.settings.cse.keypairs/obliterate">obliterate</a></code></td>
  <td>
  <code>POST /gmail/v1/users/{userId}/settings/cse/keypairs/{keyPairId}:obliterate</code> <br> Deletes a client-side encryption key pair permanently and immediately.</td>
  </tr>
  </tbody>
  </table>
  
